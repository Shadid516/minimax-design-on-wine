#!/bin/sh
# Runs at KDE logout/shutdown: closes MiniMax Design orderly instead of letting
# the session kill it mid-write. No update check here (system is shutting down).
if pgrep -f "[M]iniMax Design.exe" >/dev/null 2>&1; then
    for win in $(DISPLAY="${DISPLAY:-:1}" xwininfo -root -tree 2>/dev/null \
                 | grep -iE '0x[0-9a-f]+ "[^"]*MiniMax Design[^"]*"' | grep -oE '0x[0-9a-f]+' | sort -u); do
        "$HOME/.local/bin/x-graceful-close" "$win" 2>/dev/null
    done
    i=0
    while [ $i -lt 4 ]; do
        pgrep -f "[M]iniMax Design.exe" >/dev/null 2>&1 || break
        sleep 1; i=$((i + 1))
    done
    pgrep -f "[M]iniMax Design.exe" >/dev/null 2>&1 && { wineserver -k 2>/dev/null; sleep 2; }
    echo "$(date -Is) shutdown hook: app closed (i=$i)" >> "$HOME/.local/state/minimax-design-autoupdate.log"
fi
